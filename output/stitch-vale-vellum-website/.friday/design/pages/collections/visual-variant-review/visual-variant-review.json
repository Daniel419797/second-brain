\n                                      \"letterSpacing\": \"0.05em\",\n                                      \"fontWeight\": \"400\"\n                              }\n                      ],\n                      \"label-caps\": [\n                              \"12px\",\n                              {\n                                      \"lineHeight\": \"1.2\",\n                                      \"letterSpacing\": \"0.15em\",\n                                      \"fontWeight\": \"500\"\n                              }\n                      ],\n                      \"display-lg\": [\n                              \"64px\",\n                              {\n                                      \"lineHeight\": \"1.1\",\n                                      \"letterSpacing\": \"-0.02em\",\n                                      \"fontWeight\": \"700\"\n                              }\n                      ],\n                      \"body-md\": [\n                              \"16px\",\n                              {\n                                      \"lineHeight\": \"1.6\",\n                                      \"fontWeight\": \"400\"\n                              }\n                      ],\n                      \"headline-lg\": [\n                              \"40px\",\n                              {\n                                      \"lineHeight\": \"1.2\",\n                                      \"letterSpacing\": \"0em\",\n                                      \"fontWeight\": \"600\"\n                              }\n                      ]\n              }\n      },\n          },\n        }\n    </script>\n<style>\n        /* Custom Utilities for Tactile Editorial Style */\n        .inner-shadow-impression {\n            box-shadow: inset 0 2px 4px 0 rgba(28, 27, 27, 0.05);\n        }\n        .hairline-border {\n            border-width: 0.5px;\n        }\n        .vellum-blur {\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n        }\n        .film-grain {\n            position: relative;\n        }\n        .film-grain::after {\n            content: \"\";\n            position: absolute;\n            top: 0; left: 0; right: 0; bottom: 0;\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E\");\n            pointer-events: none;\n            z-index: 10;\n        }\n    </style>\n</head>\n<body class=\"bg-background text-on-background antialiased selection:bg-tertiary-container selection:text-tertiary\">\n<!-- TopNavBar -->\n<nav class=\"fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30 transition-all duration-700 ease-in-out\">\n<div class=\"flex justify-between items-center w-full px-margin-page py-6 max-w-none\">\n<div class=\"hidden md:flex gap-8\">\n<a class=\"font-cta text-cta uppercase tracking-widest text-on-surface-variant hover:text-on-surface transition-colors duration-500\" href=\"/conceptually-home\">Home</a>\n<a class=\"font-cta text-cta uppercase tracking-widest text-on-surface border-b border-on-surface pb-1 hover:text-on-surface transition-colors duration-500\" href=\"/collections\">Collections</a>\n</div>\n<div class=\"font-display-lg text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight\">\n                Vale &amp; Vellum\n            </div>\n<div class=\"hidden md:flex gap-8\">\n<a class=\"font-cta text-cta uppercase tracking-widest text-on-surface-variant hover:text-on-surface transition-colors duration-500\" href=\"/process\">Process</a>\n<a class=\"font-cta text-cta uppercase tracking-widest text-on-surface-variant hover:text-on-surface transition-colors duration-500\" href=\"/inquiry\">Inquiry</a>\n</div>\n<div class=\"md:hidden flex items-center\">\n<button class=\"text-on-surface hover:text-on-surface-variant transition-colors duration-500\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 0;\">menu</span>\n</button>\n</div>\n</div>\n</nav>\n<main>\n<!-- Hero Section -->\n<section class=\"relative w-full min-h-screen flex items-end pb-section-gap px-margin-page pt-32\">\n<div class=\"absolute inset-0 z-0 film-grain\">\n<img alt=\"A quieter standard of luxury, made visible.\" class=\"w-full h-full object-cover object-center opacity-90 saturate-50 mix-blend-multiply\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDOEWRtyMkWP_nEzJ2dbsu2ic0yppNJQw0mU-SfBl5HEC14MeNJ5uAYtxXKamZ--XGMkFEjpluO1Hhv5TVU_RLNYprc9sR7m_5_irYmLVuKR3Bg9j9BbCy7bsG2NFl2H2s0dHWnkQ5of-srWD0DQapO7MnCs4_NOL8G8MpuA8BK71ZR3f_r_VnrMab_l9no5vZ8Ta2PrsX7APtSVljx57YS89PND6PoSaFBLGhGsgxL-l4Ysei3E3EOYy4RAgc1-J5hZvnvzCR0Z2U\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent\"></div>\n</div>\n<div class=\"relative z-10 max-w-4xl grid grid-cols-1 md:grid-cols-12 gap-gutter items-end\">\n<div class=\"md:col-span-8 md:col-start-1 space-y-8\">\n<h1 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg text-on-surface tracking-tight leading-none drop-shadow-sm\">\n                        A quieter standard of luxury, made visible.\n                    </h1>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant max-w-2xl\">\n                        Hand-crafted provenance. Every suite is an archival artifact, born from deep letterpress impressions and heritage paper stocks.\n                    </p>\n<div class=\"pt-4\">\n<a class=\"inline-flex items-center gap-2 font-cta text-cta uppercase tracking-widest text-on-surface border-b border-on-surface pb-1 hover:text-tertiary hover:border-tertiary transition-colors duration-500\" href=\"#collections\">\n                            View the Collection\n                            <span class=\"material-symbols-outlined text-sm\" style=\"font-variation-settings: 'FILL' 0;\">arrow_downward</span>\n</a>\n</div>\n</div>\n</div>\n</section>\n<!-- Letterpress Divider -->\n<div class=\"w-full flex justify-center py-16 opacity-50\">\n<div class=\"w-px h-24 bg-gradient-to-b from-transparent via-tertiary to-transparent\"></div>\n</div>\n<!-- Provenance Section -->\n<section class=\"px-margin-page py-section-gap\">\n<div class=\"grid grid-cols-1 md:grid-cols-12 gap-gutter items-center\">\n<div class=\"md:col-span-5 md:col-start-2 space-y-6 order-2 md:order-1 mt-12 md:mt-0\">\n<span class=\"font-label-caps text-label-caps text-tertiary uppercase flex items-center gap-2\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary\"></span> The Atelier Detail\n                    </span>\n<h2 class=\"font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight\">\n                        Material Provenance\n                    </h2>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant\">\n                        Our work rejects the disposable. We source 600gsm cotton stock, hand-mix custom inks, and apply deep bronze foil stamps. Each piece is a tactile experience, designed to be kept, felt, and remembered long after the event concludes.\n                    </p>\n<div class=\"flex flex-wrap gap-4 pt-4\">\n<span class=\"font-label-caps text-label-caps text-on-surface flex items-center gap-1\"><span class=\"text-tertiary\">\u2022</span> 600gsm Cotton</span>\n<span class=\"font-label-caps text-label-caps text-on-surface flex items-center gap-1\"><span class=\"text-tertiary\">\u2022</span> Hand-Mixed Inks</span>\n<span class=\"font-label-caps text-label-caps text-on-surface flex items-center gap-1\"><span class=\"text-tertiary\">\u2022</span> Custom Bronze Foil</span>\n</div>\n</div>\n<div class=\"md:col-span-6 order-1 md:order-2 film-grain\">\n<img alt=\"Macro detail of material provenance\" class=\"w-full h-auto object-cover grayscale-[20%] sepia-[10%] inner-shadow-impression border border-outline-variant/30\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBfC5FOmwE41BjedTQhQeypkyPouaFVC7NEh-LlDXhHHgHuB5XfA1uKgokwTF1Rr60b-Td6uLmz7Xe49DO8ZxIq3JBC07cc_iw-XZ1RaWl4o56IwWaTS7Sv77Je4lyE483MPo1QpU4MAsdVBU2wxNb_h8F-laVDSLJ_HNQ7FPsK3rw5iTO1V5fRYEbvOnTFPZruV5MvCsFE2bN8WIQ-odwh3l0O2XxrAljlrdiuIltArwnmjaBegvM2OI8Dbz2oMSbu1Y4NGqAzGUA\"/>\n</div>\n</div>\n</section>\n<!-- Collections Grid -->\n<section class=\"px-margin-page py-section-gap bg-surface-container-low border-y border-outline-variant/20\" id=\"collections\">\n<div class=\"max-w-7xl mx-auto space-y-24\">\n<div class=\"text-center space-y-4 max-w-2xl mx-auto\">\n<h2 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg text-on-surface\">Curated Suites</h2>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant\">An exploration of texture and typography, carefully balanced for discerning occasions.</p>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-gutter gap-y-24\">\n<!-- Suite 1 -->\n<article class=\"group cursor-pointer\">\n<div class=\"aspect-[4/5] overflow-hidden mb-8 film-grain bg-surface-variant inner-shadow-impression\">\n<div class=\"w-full h-full bg-[url('https://images.unsplash.com/photo-1586075010923-2dd4570fb338?auto=format&amp;fit=crop&amp;q=80')] bg-cover bg-center transition-transform duration-1000 group-hover:scale-105 saturate-50\" data-alt=\"A minimalist flat lay of a luxury wedding invitation suite on a textured stone surface. The suite features crisp sans-serif typography, deep charcoal ink debossed into thick, off-white cotton paper. Subtle shadows create a sense of depth and elegance. The lighting is soft and diffused, emphasizing the sophisticated, modern aesthetic of the stationery.\"></div>\n</div>\n<div class=\"space-y-4\">\n<span class=\"font-label-caps text-label-caps text-tertiary uppercase\">01 \u2014 The Signature</span>\n<h3 class=\"font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface group-hover:text-tertiary transition-colors duration-500\">Minimalist Permanence</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant border-t hairline-border border-outline-variant/50 pt-4\">\n                                Crisp letterpress impression on heavy ivory stock, accented with translucent vellum wraps.\n                            </p>\n</div>\n</article>\n<!-- Suite 2 (Offset) -->\n<article class=\"group cursor-pointer md:mt-32\">\n<div class=\"aspect-[4/5] overflow-hidden mb-8 film-grain bg-surface-variant inner-shadow-impression\">\n<div class=\"w-full h-full bg-[url('https://images.unsplash.com/photo-1522030164627-6f81ce5b5b99?auto=format&amp;fit=crop&amp;q=80')] bg-cover bg-center transition-transform duration-1000 group-hover:scale-105 saturate-50\" data-alt=\"Close-up of a handmade paper envelope with a custom bronze wax seal and delicate silk ribbon. The texture of the rough, deckled edges of the paper is prominent against a dark, moody background. Warm, directional lighting highlights the metallic sheen of the seal and the soft weave of the ribbon. A highly tactile and romantic stationery composition.\"></div>\n</div>\n<div class=\"space-y-4\">\n<span class=\"font-label-caps text-label-caps text-tertiary uppercase\">02 \u2014 Weekend Details</span>\n<h3 class=\"font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface group-hover:text-tertiary transition-colors duration-500\">Narrative Itineraries</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant border-t hairline-border border-outline-variant/50 pt-4\">\n                                Deckled edges and intricate map illustrations, guiding guests through multi-day celebrations.\n                            </p>\n</div>\n</article>\n<!-- Suite 3 -->\n<article class=\"group cursor-pointer md:col-span-2 md:w-3/4 mx-auto mt-12 md:mt-0\">\n<div class=\"aspect-[16/9] overflow-hidden mb-8 film-grain bg-surface-variant inner-shadow-impression\">\n<div class=\"w-full h-full bg-[url('https://images.unsplash.com/photo-1606322867088-75b28b7e28aa?auto=format&amp;fit=crop&amp;q=80')] bg-cover bg-center transition-transform duration-1000 group-hover:scale-105 saturate-50\" data-alt=\"An expansive, asymmetrical flat lay of a bespoke editorial wedding suite. Several pieces of stationery, including menus, place cards, and invitations, are arranged thoughtfully on a draped linen cloth. Highlights of muted rose watercolor washes and intricate gold foil stamping are visible. The scene is lit with bright, natural light creating a soft, ethereal mood characteristic of high-end wedding editorial photography.\"></div>\n</div>\n<div class=\"space-y-4 text-center max-w-2xl mx-auto\">\n<span class=\"font-label-caps text-label-caps text-tertiary uppercase\">03 \u2014 Bespoke Editorial</span>\n<h3 class=\"font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface group-hover:text-tertiary transition-colors duration-500\">Fully Custom Commissions</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant border-t hairline-border border-outline-variant/50 pt-4\">\n                                From hand-drawn crests to custom dye-cut folios. An entirely unique visual identity for your event.\n                            </p>\n</div>\n</article>\n</div>\n</div>\n</section>\n<!-- Planner Concierge -->\n<section class=\"px-margin-page py-section-gap\">\n<div class=\"max-w-4xl mx-auto border border-outline-variant/50 p-12 md:p-24 relative bg-surface inner-shadow-impression\">\n<div class=\"absolute -top-4 left-1/2 -translate-x-1/2 bg-surface px-6 font-label-caps text-label-caps text-tertiary tracking-widest uppercase\">\n                    White-Glove Service\n                </div>\n<div class=\"text-center space-y-8\">\n<h2 class=\"font-display-lg text-headline-lg-mobile md:text-headline-lg text-on-surface\">Planner Concierge</h2>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto\">\n                        Dedicated support for event planners and private clients requiring discreet, high-touch execution.\n                    </p>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 border-t hairline-border border-outline-variant/30 text-left\">\n<div>\n<h4 class=\"font-cta text-cta text-on-surface uppercase mb-2\">Rush Availability</h4>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Expedited timelines for bespoke production when necessary.</p>\n</div>\n<div>\n<h4 class=\"font-cta text-cta text-on-surface uppercase mb-2\">Sample Kits</h4>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Curated portfolios of our papers, foils, and printing methods sent directly to your studio.</p>\n</div>\n<div>\n<h4 class=\"font-cta text-cta text-on-surface uppercase mb-2\">White-Glove Assembly</h4>\n<p class=\"font-body-md text-body-md text-on-surface-variant\">Meticulous stuffing, sealing, and vintage postage curation.</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Inquiry Form Section -->\n<section class=\"px-margin-page py-section-gap bg-surface-container-low border-t border-outline-variant/20\">\n<div class=\"max-w-3xl mx-auto\">\n<div class=\"text-center mb-16 space-y-4\">\n<h2 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg text-on-surface\">Private Appointment</h2>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant\">Begin the commission process by sharing the initial details of your event.</p>\n</div>\n<form class=\"space-y-12\">\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-gutter gap-y-12\">\n<div class=\"relative\">\n<label class=\"block font-label-caps text-label-caps text-on-surface-variant uppercase mb-2\" for=\"name\">Name</label>\n<input class=\"w-full bg-transparent border-0 border-b border-on-surface/30 px-0 py-2 font-body-lg text-body-lg text-on-surface focus:ring-0 focus:border-tertiary transition-colors\" id=\"name\" placeholder=\"Your full name\" type=\"text\"/>\n</div>\n<div class=\"relative\">\n<label class=\"block font-label-caps text-label-caps text-on-surface-variant uppercase mb-2\" for=\"email\">Email</label>\n<input class=\"w-full bg-transparent border-0 border-b border-on-surface/30 px-0 py-2 font-body-lg text-body-lg text-on-surface focus:ring-0 focus:border-tertiary transition-colors\" id=\"email\" placeholder=\"hello@example.com\" type=\"email\"/>\n</div>\n<div class=\"relative\">\n<label class=\"block font-label-caps text-label-caps text-on-surface-variant uppercase mb-2\" for=\"date\">Event Date</label>\n<input class=\"w-full bg-transparent border-0 border-b border-on-surface/30 px-0 py-2 font-body-lg text-body-lg text-on-surface focus:ring-0 focus:border-tertiary transition-colors\" id=\"date\" placeholder=\"MM / DD / YYYY\" type=\"text\"/>\n</div>\n<div class=\"relative\">\n<label class=\"block font-label-caps text-label-caps text-on-surface-variant uppercase mb-2\" for=\"guests\">Estimated Guest Count</label>\n<input class=\"w-full bg-transparent border-0 border-b border-on-surface/30 px-0 py-2 font-body-lg text-body-lg text-on-surface focus:ring-0 focus:border-tertiary transition-colors\" id=\"guests\" placeholder=\"e.g. 150\" type=\"text\"/>\n</div>\n</div>\n<div class=\"relative\">\n<label class=\"block font-label-caps text-label-caps text-on-surface-variant uppercase mb-2\" for=\"materials\">Material Preferences &amp; Notes</label>\n<textarea class=\"w-full bg-transparent border-0 border-b border-on-surface/30 px-0 py-2 font-body-lg text-body-lg text-on-surface focus:ring-0 focus:border-tertiary transition-colors resize-none\" id=\"materials\" placeholder=\"Tell us about the textures and colors you envision...\" rows=\"3\"></textarea>\n</div>\n<div class=\"pt-8 text-center md:text-left\">\n<button class=\"inline-block border border-on-surface px-8 py-4 font-cta text-cta uppercase tracking-widest text-on-surface hover:bg-on-surface hover:text-surface transition-all duration-300\" type=\"submit\">\n                            Submit Inquiry\n                        </button>\n</div>\n</form>\n</div>\n</section>\n</main>\n<!-- Footer -->\n<footer class=\"w-full mt-section-gap bg-surface-container-low border-t border-outline-variant/50 grid grid-cols-1 md:grid-cols-3 gap-gutter px-margin-page py-section-gap ease-out duration-500\">\n<div class=\"font-display-lg text-headline-lg-mobile md:text-headline-lg text-on-surface md:col-span-1\">\n            Vale &amp; Vellum\n        </div>\n<div class=\"md:col-span-1 flex flex-col gap-4\">\n<a class=\"font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-opacity duration-300\" href=\"#\">Newsletter Signup</a>\n<a class=\"font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-opacity duration-300\" href=\"#\">Studio Locations</a>\n</div>\n<div class=\"md:col-span-1 flex flex-col gap-4\">\n<a class=\"font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-opacity duration-300\" href=\"#\">Privacy Policy</a>\n<a class=\"font-body-md text-body-md text-on-surface-variant hover:text-on-surface transition-opacity duration-300\" href=\"#\">Terms of Service</a>\n</div>\n<div class=\"md:col-span-3 mt-8 pt-8 border-t border-outline-variant/30 font-body-md text-body-md text-on-surface-variant text-center md:text-left\">\n            \u00a9 2024 Vale &amp; Vellum Atelier. All Rights Reserved. Material Provenance Guaranteed.\n        </div>\n</footer>\n<script>\n        // Subtle scroll effect for the nav\n        window.addEventListener('scroll', () => {\n            const nav = document.querySelector('nav');\n            if (window.scrollY > 50) {\n                nav.classList.add('py-4');\n                nav.classList.remove('py-6');\n                nav.classList.add('shadow-sm');\n            } else {\n                nav.classList.add('py-6');\n                nav.classList.remove('py-4');\n                nav.classList.remove('shadow-sm');\n            }\n        });\n    </script>\n</body></html>",
